diff --git a/build.zig b/build.zig
index 4af884e3f3a19c653036acf924a6092de426979b..e2da03872a87c9b453e8e2dbda5f4d3e847a564c 100644
--- a/build.zig
+++ b/build.zig
@@ -128,13 +128,16 @@ pub fn build(b: *std.Build) void {
     _ = ids_files.addCopyFile(b.path("zig/src/families/nemotron/draft_ids.txt"), "draft_ids.txt");
     const draft_ids = b.createModule(.{ .root_source_file = ids_files.add("draft_ids.zig", "pub const text = @embedFile(\"draft_ids.txt\");\n") });
     const test_step = b.step("test", "Host-side unit tests (no GPU work)");
+    // the structured-output shim needs a local xgrammar build; empty: its tests skip
+    const xgrammar = b.option([]const u8, "xgrammar", "xgrammar install prefix (include/, lib/libxgrammar.a): builds the structured-output shim") orelse "";
+    const so_runtime = b.option([]const u8, "so-runtime", "runtime path of libtfso.so, as the image installs it") orelse "";
     switch (target.result.os.tag) {
         .macos => metalTargets(b, target, optimize, draft_ids, build_options, test_step),
-        .linux => cuda_build.targets(b, target, optimize, draft_ids, build_options),
+        .linux => cuda_build.targets(b, target, optimize, draft_ids, build_options, xgrammar, so_runtime),
         else => {},
     }
     dist_build.targets(b, draft_ids, build_options, release_version);
-    cuda_build.hostTests(b, draft_ids, test_step);
+    cuda_build.hostTests(b, draft_ids, test_step, xgrammar, so_runtime);
 }
 
