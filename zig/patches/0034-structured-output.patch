diff --git a/zig/src/core/structure.zig b/zig/src/core/structure.zig
new file mode 100644
index 0000000000000000000000000000000000000000..73082fae312a1e9c03263298e70a309bb3d5e917
--- /dev/null
+++ b/zig/src/core/structure.zig
@@ -0,0 +1,253 @@
+//! The structured-output compile cache: a (kind, grammar text) -> compiled grammar map bounded by
+//! bytes, deduplicated across concurrent requests, and compiled off the caller's thread. Every
+//! compile goes through the shim in core/structure/api.zig. The key holds the whole text and is
+//! compared as a string, so a hash collision can never return the wrong grammar.
+const std = @import("std");
+const api_mod = @import("structure/api.zig");
+
+pub const Api = api_mod.Api;
+pub const Kind = enum { json, json_schema, regex, choice, grammar };
+
+pub const Grammar = struct { ptr: *anyopaque, bytes: usize };
+
+const Entry = struct { g: Grammar, key: []u8, tick: u64 };
+
+const Job = struct {
+    /// 0 running, 1 done, 2 failed.
+    state: std.atomic.Value(u8) = .init(0),
+    g: ?Grammar = null,
+    errlen: usize = 0,
+    errbuf: [512]u8 = std.mem.zeroes([512]u8),
+};
+
+pub const Cache = struct {
+    a: std.mem.Allocator,
+    io: std.Io,
+    api: *Api,
+    ctx: ?*anyopaque,
+    limit: usize,
+    mutex: std.Io.Mutex = .init,
+    map: std.StringHashMapUnmanaged(Entry) = .empty,
+    inflight: std.StringHashMapUnmanaged(*Job) = .empty,
+    jobs: std.ArrayListUnmanaged(*Job) = .empty,
+    tick: u64 = 0,
+    total_bytes: usize = 0,
+
+    pub fn init(a: std.mem.Allocator, io: std.Io, api: *Api, ctx: ?*anyopaque, limit: usize) Cache {
+        return .{ .a = a, .io = io, .api = api, .ctx = ctx, .limit = limit };
+    }
+
+    pub fn deinit(self: *Cache) void {
+        var it = self.map.iterator();
+        while (it.next()) |e| {
+            self.api.grammar_free(e.value_ptr.g.ptr);
+            self.a.free(e.value_ptr.key);
+        }
+        self.map.deinit(self.a);
+        self.inflight.deinit(self.a);
+        for (self.jobs.items) |job| self.a.destroy(job);
+        self.jobs.deinit(self.a);
+    }
+
+    pub fn currentBytes(self: *Cache) usize {
+        self.mutex.lockUncancelable(self.io);
+        defer self.mutex.unlock(self.io);
+        return self.total_bytes;
+    }
+
+    /// The compiled grammar for (kind, text): from the cache, from an in-flight compile of the
+    /// same key, or from a new worker thread. Returns error.Timeout when the compile outlives
+    /// timeout_ms (the worker finishes in the background and its result is dropped).
+    pub fn getOrCompile(self: *Cache, kind: Kind, text: []const u8, err: []u8, timeout_ms: u64) !*anyopaque {
+        const key = try std.fmt.allocPrint(self.a, "{s}\x00{s}", .{ @tagName(kind), text });
+        var owner = false;
+
+        self.mutex.lockUncancelable(self.io);
+        if (self.map.getPtr(key)) |e| {
+            self.tick += 1;
+            e.tick = self.tick;
+            const ptr = e.g.ptr;
+            self.mutex.unlock(self.io);
+            self.a.free(key);
+            return ptr;
+        }
+        var job: *Job = undefined;
+        if (self.inflight.get(key)) |existing| {
+            job = existing;
+        } else {
+            job = self.a.create(Job) catch |e| {
+                self.mutex.unlock(self.io);
+                self.a.free(key);
+                return e;
+            };
+            job.* = .{};
+            self.jobs.append(self.a, job) catch |e| {
+                self.a.destroy(job);
+                self.mutex.unlock(self.io);
+                self.a.free(key);
+                return e;
+            };
+            self.inflight.put(self.a, key, job) catch |e| {
+                self.mutex.unlock(self.io);
+                self.a.free(key);
+                return e;
+            };
+            owner = true;
+        }
+        self.mutex.unlock(self.io);
+
+        if (owner) {
+            const t = std.Thread.spawn(.{}, compileJob, .{ self, kind, text, key, job }) catch |e| {
+                self.finishJob(key, job, null, "could not spawn a compile thread");
+                self.a.free(key);
+                return e;
+            };
+            t.detach();
+        } else {
+            // the owner's worker owns and frees this key
+            self.a.free(key);
+        }
+
+        var waited: u64 = 0;
+        while (job.state.load(.acquire) == 0) {
+            if (waited >= timeout_ms) return error.Timeout;
+            std.Io.sleep(self.io, .fromMilliseconds(1), .awake) catch {};
+            waited += 1;
+        }
+        if (job.state.load(.acquire) == 2) {
+            const n = @min(job.errlen, err.len);
+            @memcpy(err[0..n], job.errbuf[0..n]);
+            return error.CompileFailed;
+        }
+        return job.g.?.ptr;
+    }
+
+    fn compileJob(self: *Cache, kind: Kind, text: []const u8, key: []u8, job: *Job) void {
+        var msg: [512]u8 = std.mem.zeroes([512]u8);
+        if (self.compileOne(kind, text, &msg)) |g| {
+            self.finishJob(key, job, g, "");
+        } else |_| {
+            self.finishJob(key, job, null, std.mem.sliceTo(&msg, 0));
+        }
+        self.a.free(key);
+    }
+
+    fn compileOne(self: *Cache, kind: Kind, text: []const u8, msg: []u8) !Grammar {
+        const ztext = try self.a.allocSentinel(u8, text.len, 0);
+        @memcpy(ztext[0..text.len], text);
+        defer self.a.free(ztext);
+        const ptr = switch (kind) {
+            .json => self.api.compile_json(self.ctx, "{\"type\":\"object\"}", 1, msg.ptr, @intCast(msg.len)),
+            .json_schema => self.api.compile_json(self.ctx, ztext.ptr, 1, msg.ptr, @intCast(msg.len)),
+            .regex => self.api.compile_regex(self.ctx, ztext.ptr, msg.ptr, @intCast(msg.len)),
+            .choice => blk: {
+                const ebnf = try choiceGrammar(self.a, text, msg);
+                defer self.a.free(ebnf);
+                const zebnf = try self.a.allocSentinel(u8, ebnf.len, 0);
+                @memcpy(zebnf[0..ebnf.len], ebnf);
+                defer self.a.free(zebnf);
+                break :blk self.api.compile_grammar(self.ctx, zebnf.ptr, msg.ptr, @intCast(msg.len));
+            },
+            .grammar => self.api.compile_grammar(self.ctx, ztext.ptr, msg.ptr, @intCast(msg.len)),
+        };
+        if (ptr == null) return error.CompileFailed;
+        return .{ .ptr = ptr.?, .bytes = self.api.grammar_bytes(ptr.?) };
+    }
+
+    fn finishJob(self: *Cache, key: []u8, job: *Job, g: ?Grammar, msg: []const u8) void {
+        self.mutex.lockUncancelable(self.io);
+        defer self.mutex.unlock(self.io);
+        if (g) |gram| {
+            const k = self.a.dupe(u8, key) catch {
+                job.state.store(2, .release);
+                _ = self.inflight.fetchRemove(key);
+                return;
+            };
+            if (self.map.getPtr(k)) |e| {
+                // a concurrent insert won the race: keep the older grammar, drop ours
+                self.a.free(k);
+                self.api.grammar_free(gram.ptr);
+                job.g = e.g;
+                job.state.store(1, .release);
+            } else {
+                self.tick += 1;
+                self.map.put(self.a, k, .{ .g = gram, .key = k, .tick = self.tick }) catch {
+                    self.a.free(k);
+                    self.api.grammar_free(gram.ptr);
+                    job.state.store(2, .release);
+                    _ = self.inflight.fetchRemove(key);
+                    return;
+                };
+                self.total_bytes += gram.bytes;
+                self.evictLocked();
+                job.g = gram;
+                job.state.store(1, .release);
+            }
+        } else {
+            const n = @min(msg.len, job.errbuf.len);
+            @memcpy(job.errbuf[0..n], msg[0..n]);
+            job.errlen = n;
+            job.state.store(2, .release);
+        }
+        _ = self.inflight.fetchRemove(key);
+    }
+
+    fn evictLocked(self: *Cache) void {
+        if (self.limit == 0) return;
+        while (self.total_bytes > self.limit and self.map.count() > 0) {
+            var oldest_key: ?[]const u8 = null;
+            var oldest_tick: u64 = std.math.maxInt(u64);
+            var it = self.map.iterator();
+            while (it.next()) |e| {
+                if (e.value_ptr.tick < oldest_tick) {
+                    oldest_tick = e.value_ptr.tick;
+                    oldest_key = e.key_ptr.*;
+                }
+            }
+            const k = oldest_key orelse break;
+            if (self.map.fetchRemove(k)) |kv| {
+                self.total_bytes -= kv.value.g.bytes;
+                self.api.grammar_free(kv.value.g.ptr);
+                self.a.free(kv.value.key);
+            }
+        }
+    }
+};
+
+/// guided_choice: a JSON array of strings becomes an EBNF alternation of quoted literals, so the
+/// grammar matches the JSON string form ("a" with its quotes) that a reply must produce.
+pub fn choiceGrammar(a: std.mem.Allocator, choices_json: []const u8, msg: []u8) ![]u8 {
+    const parsed = std.json.parseFromSlice(std.json.Value, a, choices_json, .{}) catch {
+        const t = "choice is not valid JSON";
+        @memcpy(msg[0..@min(msg.len, t.len)], t);
+        return error.BadChoice;
+    };
+    defer parsed.deinit();
+    if (parsed.value != .array or parsed.value.array.items.len == 0) {
+        const t = "choice must be a non-empty array";
+        @memcpy(msg[0..@min(msg.len, t.len)], t);
+        return error.BadChoice;
+    }
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    try out.appendSlice(a, "root ::= ");
+    for (parsed.value.array.items, 0..) |item, i| {
+        if (i > 0) try out.appendSlice(a, " | ");
+        if (item != .string) {
+            const t = "choice entries must be strings";
+            @memcpy(msg[0..@min(msg.len, t.len)], t);
+            return error.BadChoice;
+        }
+        try out.append(a, '"'); // EBNF string open
+        try out.append(a, '\\');
+        try out.append(a, '"'); // the JSON string's opening quote
+        for (item.string) |ch| {
+            if (ch == '"' or ch == '\\') try out.append(a, '\\');
+            try out.append(a, ch);
+        }
+        try out.append(a, '\\');
+        try out.append(a, '"'); // the JSON string's closing quote
+        try out.append(a, '"'); // EBNF string close
+    }
+    return out.toOwnedSlice(a);
+}
diff --git a/zig/src/core/structure/api.zig b/zig/src/core/structure/api.zig
new file mode 100644
index 0000000000000000000000000000000000000000..29001b6980afad9e55fd3ff4b0ca44438816e525
--- /dev/null
+++ b/zig/src/core/structure/api.zig
@@ -0,0 +1,56 @@
+//! The shim's symbols, resolved from the shared library g++ builds (core/structure/tfso.cc).
+//! Loading at run time keeps the C++/Zig boundary at plain C and lets a build without the library
+//! simply not advertise structured output. Missing library or symbol = error, never a crash.
+const std = @import("std");
+
+pub const InitFn = *const fn ([*]const ?[*]const u8, [*]const i32, i32, i32, ?[*]const i32, i32, [*]u8, i32) callconv(.c) ?*anyopaque;
+pub const CompileJsonFn = *const fn (?*anyopaque, [*:0]const u8, i32, [*]u8, i32) callconv(.c) ?*anyopaque;
+pub const CompileTextFn = *const fn (?*anyopaque, [*:0]const u8, [*]u8, i32) callconv(.c) ?*anyopaque;
+pub const GrammarBytesFn = *const fn (?*anyopaque) callconv(.c) usize;
+pub const MatcherCreateFn = *const fn (?*anyopaque, ?*anyopaque, [*]u8, i32) callconv(.c) ?*anyopaque;
+pub const FillFn = *const fn (?*anyopaque, [*]i32) callconv(.c) i32;
+pub const AcceptFn = *const fn (?*anyopaque, i32) callconv(.c) i32;
+pub const TerminatedFn = *const fn (?*anyopaque) callconv(.c) i32;
+pub const MatcherFreeFn = *const fn (?*anyopaque) callconv(.c) void;
+pub const GrammarFreeFn = *const fn (?*anyopaque) callconv(.c) void;
+pub const CtxFreeFn = *const fn (?*anyopaque) callconv(.c) void;
+
+pub const Api = struct {
+    lib: std.DynLib,
+    init: InitFn,
+    compile_json: CompileJsonFn,
+    compile_regex: CompileTextFn,
+    compile_grammar: CompileTextFn,
+    grammar_bytes: GrammarBytesFn,
+    matcher_create: MatcherCreateFn,
+    fill: FillFn,
+    accept: AcceptFn,
+    terminated: TerminatedFn,
+    matcher_free: MatcherFreeFn,
+    grammar_free: GrammarFreeFn,
+    ctx_free: CtxFreeFn,
+
+    pub fn load(path: []const u8) !Api {
+        var lib = try std.DynLib.open(path);
+        errdefer lib.close();
+        return .{
+            .lib = lib,
+            .init = lib.lookup(InitFn, "tfso_init") orelse return error.MissingSymbol,
+            .compile_json = lib.lookup(CompileJsonFn, "tfso_compile_json_schema") orelse return error.MissingSymbol,
+            .compile_regex = lib.lookup(CompileTextFn, "tfso_compile_regex") orelse return error.MissingSymbol,
+            .compile_grammar = lib.lookup(CompileTextFn, "tfso_compile_grammar") orelse return error.MissingSymbol,
+            .grammar_bytes = lib.lookup(GrammarBytesFn, "tfso_grammar_bytes") orelse return error.MissingSymbol,
+            .matcher_create = lib.lookup(MatcherCreateFn, "tfso_matcher_create") orelse return error.MissingSymbol,
+            .fill = lib.lookup(FillFn, "tfso_fill_bitmask") orelse return error.MissingSymbol,
+            .accept = lib.lookup(AcceptFn, "tfso_accept_token") orelse return error.MissingSymbol,
+            .terminated = lib.lookup(TerminatedFn, "tfso_terminated") orelse return error.MissingSymbol,
+            .matcher_free = lib.lookup(MatcherFreeFn, "tfso_matcher_free") orelse return error.MissingSymbol,
+            .grammar_free = lib.lookup(GrammarFreeFn, "tfso_grammar_free") orelse return error.MissingSymbol,
+            .ctx_free = lib.lookup(CtxFreeFn, "tfso_ctx_free") orelse return error.MissingSymbol,
+        };
+    }
+
+    pub fn close(self: *Api) void {
+        self.lib.close();
+    }
+};
diff --git a/zig/src/core/structure/tfso.cc b/zig/src/core/structure/tfso.cc
new file mode 100644
index 0000000000000000000000000000000000000000..739b65bfb47ec99270db2f2499ddc53f4854db83
--- /dev/null
+++ b/zig/src/core/structure/tfso.cc
@@ -0,0 +1,243 @@
+//! The shim's implementation: xgrammar 0.2.2 behind tfso.h. C++ stays on this side of the
+//! boundary; only POD crosses to Zig. Every xgrammar call is wrapped: the library throws
+//! (XGrammarError and friends) instead of returning status, so an uncaught exception would
+//! unwind through Zig frames.
+#include "tfso.h"
+
+#include <dlpack/dlpack.h>
+#include <xgrammar/compiler.h>
+#include <xgrammar/grammar.h>
+#include <xgrammar/matcher.h>
+#include <xgrammar/tokenizer_info.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace {
+
+void set_err(char* err, int cap, const char* what) {
+    if (err == nullptr || cap <= 0) return;
+    std::snprintf(err, static_cast<size_t>(cap), "%s", what != nullptr ? what : "xgrammar error");
+}
+
+void set_err(char* err, int cap, const std::exception& e) { set_err(err, cap, e.what()); }
+
+/// TF_DS_SO_TRACE=1: name every input before compiling it. xgrammar's fatal path can abort the
+/// process, so the last line on stderr is the only record of what it refused.
+void tfso_trace(const char* what, const char* detail) {
+    if (std::getenv("TF_DS_SO_TRACE") == nullptr) return;
+    std::fprintf(stderr, "tfso: %s: %.400s\n", what, detail != nullptr ? detail : "");
+}
+
+}  // namespace
+
+struct tfso_ctx {
+    xgrammar::TokenizerInfo ti;
+    std::unique_ptr<xgrammar::GrammarCompiler> compiler;
+    int32_t padded;  // the model's padded vocabulary: the bitmask's width
+};
+
+struct tfso_grammar {
+    xgrammar::CompiledGrammar g;
+    explicit tfso_grammar(xgrammar::CompiledGrammar&& c) : g(std::move(c)) {}
+};
+
+struct tfso_matcher {
+    // The matcher holds its own copy of the compiled grammar (shared_ptr pimpl), so eviction
+    // from the Zig-side cache cannot free it while this matcher lives.
+    std::unique_ptr<xgrammar::GrammarMatcher> m;
+    int words;  // ceil(padded_vocab / 32): the caller's bitmask length
+};
+
+extern "C" {
+
+tfso_ctx* tfso_init(const char* const* bytes, const int32_t* lens, int32_t n,
+                    int32_t padded_vocab, const int32_t* stops, int32_t nstops,
+                    char* err, int cap) {
+    try {
+        if (bytes == nullptr || lens == nullptr || n <= 0) {
+            set_err(err, cap, "empty vocabulary");
+            return nullptr;
+        }
+        std::vector<std::string> vocab;
+        vocab.reserve(static_cast<size_t>(n));
+        for (int32_t i = 0; i < n; ++i) {
+            const int32_t len = lens[i];
+            if (len < 0 || (len > 0 && bytes[i] == nullptr)) {
+                set_err(err, cap, "bad vocabulary entry");
+                return nullptr;
+            }
+            vocab.emplace_back(len > 0 ? bytes[i] : "", static_cast<size_t>(len));
+        }
+        std::optional<std::vector<int32_t>> stop_ids;
+        if (stops != nullptr && nstops > 0)
+            stop_ids = std::vector<int32_t>(stops, stops + nstops);
+        auto* ctx = new tfso_ctx{
+            xgrammar::TokenizerInfo(std::move(vocab), xgrammar::VocabType::RAW,
+                                    static_cast<int>(padded_vocab), std::move(stop_ids), false),
+            nullptr,
+            padded_vocab,
+        };
+        ctx->compiler = std::make_unique<xgrammar::GrammarCompiler>(ctx->ti);
+        return ctx;
+    } catch (const std::exception& e) {
+        set_err(err, cap, e);
+        return nullptr;
+    } catch (...) {
+        set_err(err, cap, "unknown xgrammar failure in init");
+        return nullptr;
+    }
+}
+
+tfso_grammar* tfso_compile_json_schema(tfso_ctx* ctx, const char* schema, int strict,
+                                       char* err, int cap) {
+    try {
+        if (ctx == nullptr || schema == nullptr) {
+            set_err(err, cap, "no context or schema");
+            return nullptr;
+        }
+        tfso_trace("json_schema", schema);
+        auto g = ctx->compiler->CompileJSONSchema(std::string(schema),
+                                                  /*any_whitespace=*/false,
+                                                  /*indent=*/std::nullopt,
+                                                  /*separators=*/std::nullopt,
+                                                  /*strict_mode=*/strict != 0);
+        return new tfso_grammar(std::move(g));
+    } catch (const std::exception& e) {
+        set_err(err, cap, e);
+        return nullptr;
+    } catch (...) {
+        set_err(err, cap, "unknown xgrammar failure in CompileJSONSchema");
+        return nullptr;
+    }
+}
+
+tfso_grammar* tfso_compile_regex(tfso_ctx* ctx, const char* pattern, char* err, int cap) {
+    try {
+        if (ctx == nullptr || pattern == nullptr) {
+            set_err(err, cap, "no context or pattern");
+            return nullptr;
+        }
+        tfso_trace("regex", pattern);
+        auto g = ctx->compiler->CompileRegex(std::string(pattern));
+        return new tfso_grammar(std::move(g));
+    } catch (const std::exception& e) {
+        set_err(err, cap, e);
+        return nullptr;
+    } catch (...) {
+        set_err(err, cap, "unknown xgrammar failure in CompileRegex");
+        return nullptr;
+    }
+}
+
+tfso_grammar* tfso_compile_grammar(tfso_ctx* ctx, const char* ebnf, char* err, int cap) {
+    try {
+        if (ctx == nullptr || ebnf == nullptr) {
+            set_err(err, cap, "no context or grammar");
+            return nullptr;
+        }
+        tfso_trace("grammar", ebnf);
+        auto g = ctx->compiler->CompileGrammar(xgrammar::Grammar::FromEBNF(std::string(ebnf)));
+        return new tfso_grammar(std::move(g));
+    } catch (const std::exception& e) {
+        set_err(err, cap, e);
+        return nullptr;
+    } catch (...) {
+        set_err(err, cap, "unknown xgrammar failure in CompileGrammar");
+        return nullptr;
+    }
+}
+
+size_t tfso_grammar_bytes(tfso_grammar* g) {
+    if (g == nullptr) return 0;
+    try {
+        return g->g.MemorySizeBytes();
+    } catch (...) {
+        return 0;
+    }
+}
+
+void* tfso_matcher_create(tfso_ctx* ctx, tfso_grammar* g, char* err, int cap) {
+    try {
+        if (g == nullptr || ctx == nullptr) {
+            set_err(err, cap, "no grammar");
+            return nullptr;
+        }
+        auto* mt = new tfso_matcher{
+            std::make_unique<xgrammar::GrammarMatcher>(g->g),
+            static_cast<int>(xgrammar::GetBitmaskSize(static_cast<int>(ctx->padded))),
+        };
+        return mt;
+    } catch (const std::exception& e) {
+        set_err(err, cap, e);
+        return nullptr;
+    } catch (...) {
+        set_err(err, cap, "unknown xgrammar failure in matcher creation");
+        return nullptr;
+    }
+}
+
+int tfso_fill_bitmask(void* matcher, int32_t* words) {
+    auto* mt = static_cast<tfso_matcher*>(matcher);
+    if (mt == nullptr || words == nullptr) return -1;
+    try {
+        const int words_n = mt->words;
+        DLTensor t;
+        std::memset(&t, 0, sizeof(t));
+        t.device = DLDevice{kDLCPU, 0};
+        t.ndim = 1;
+        int64_t shape[1] = {words_n};
+        t.shape = shape;
+        t.strides = nullptr;
+        t.dtype = DLDataType{kDLInt, 32, 1};
+        t.byte_offset = 0;
+        t.data = words;
+        return mt->m->FillNextTokenBitmask(&t, 0, false) ? 1 : 0;
+    } catch (...) {
+        return -1;
+    }
+}
+
+int tfso_accept_token(void* matcher, int32_t id) {
+    auto* mt = static_cast<tfso_matcher*>(matcher);
+    if (mt == nullptr) return 0;
+    try {
+        return mt->m->AcceptToken(id) ? 1 : 0;
+    } catch (...) {
+        return 0;
+    }
+}
+
+int tfso_terminated(void* matcher) {
+    auto* mt = static_cast<tfso_matcher*>(matcher);
+    if (mt == nullptr) return 0;
+    try {
+        return mt->m->IsTerminated() ? 1 : 0;
+    } catch (...) {
+        return 0;
+    }
+}
+
+int tfso_rollback(void* matcher, int32_t n) {
+    auto* mt = static_cast<tfso_matcher*>(matcher);
+    if (mt == nullptr || n <= 0) return -1;
+    try {
+        mt->m->Rollback(n);
+        return 0;
+    } catch (...) {
+        return -1;
+    }
+}
+
+void tfso_matcher_free(void* matcher) { delete static_cast<tfso_matcher*>(matcher); }
+
+void tfso_grammar_free(tfso_grammar* g) { delete g; }
+
+void tfso_ctx_free(tfso_ctx* ctx) { delete ctx; }
+
+}  // extern "C"
diff --git a/zig/src/core/structure/tfso.h b/zig/src/core/structure/tfso.h
new file mode 100644
index 0000000000000000000000000000000000000000..23d6783d4ac59a20c5401e63ab8cc7a23deb8f43
--- /dev/null
+++ b/zig/src/core/structure/tfso.h
@@ -0,0 +1,57 @@
+//! The structured-output shim's C surface: xgrammar behind plain C so the Zig engine links it
+//! without a C++ ABI across the boundary. Every call that can fail takes an error buffer; the
+//! shim catches every xgrammar exception (it throws, it does not return status) and copies the
+//! message there. No global state: compile workers and the lane thread call in concurrently.
+#ifndef TFSO_H
+#define TFSO_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct tfso_ctx tfso_ctx;
+typedef struct tfso_grammar tfso_grammar;
+
+/// bytes[i]/lens[i] is token i's exact decoded bytes (RAW vocabulary); n real tokens, padded_vocab
+/// the model's padded vocabulary; stops are the stop/end ids. NULL on failure.
+tfso_ctx* tfso_init(const char* const* bytes, const int32_t* lens, int32_t n,
+                    int32_t padded_vocab, const int32_t* stops, int32_t nstops,
+                    char* err, int cap);
+
+/// JSON Schema, compiled compact (any_whitespace = false). strict 0/1 -> strict_mode.
+tfso_grammar* tfso_compile_json_schema(tfso_ctx* ctx, const char* schema, int strict,
+                                       char* err, int cap);
+tfso_grammar* tfso_compile_regex(tfso_ctx* ctx, const char* pattern, char* err, int cap);
+tfso_grammar* tfso_compile_grammar(tfso_ctx* ctx, const char* ebnf, char* err, int cap);
+
+/// CompiledGrammar::MemorySizeBytes (grammar + its adaptive mask cache).
+size_t tfso_grammar_bytes(tfso_grammar* g);
+
+/// A matcher for one request. NULL on failure.
+void* tfso_matcher_create(tfso_ctx* ctx, tfso_grammar* g, char* err, int cap);
+
+/// Fills the caller's int32 words ((vocab+31)/32, bit 1 = allowed). Returns 1 when the mask needs
+/// applying (not all-true), 0 when everything is allowed, -1 on error.
+int tfso_fill_bitmask(void* matcher, int32_t* words);
+
+/// bool: whether the token was accepted (0 = not allowed by the grammar).
+int tfso_accept_token(void* matcher, int32_t id);
+
+/// IsTerminated(): the grammar completed and its stop token was accepted.
+int tfso_terminated(void* matcher);
+
+/// v2 only (per-draft-step masks): nothing calls it with drafts off.
+int tfso_rollback(void* matcher, int32_t n);
+
+void tfso_matcher_free(void* matcher);
+void tfso_grammar_free(tfso_grammar* g);
+void tfso_ctx_free(tfso_ctx* ctx);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/zig/src/core/structure_test.zig b/zig/src/core/structure_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f622a4fa44f059f7a9fc31847ef218c1ab473a97
--- /dev/null
+++ b/zig/src/core/structure_test.zig
@@ -0,0 +1,162 @@
+//! The structured-output shim's and cache's tests (core/structure.zig over xgrammar 0.2.2).
+//! The shim needs a local xgrammar build: `zig build test -Dxgrammar=$HOME/opt/xgrammar-0.2.2`.
+//! Without the flag the shim tests skip, so a bare host still runs the rest of the suite.
+const std = @import("std");
+const bo = @import("build_options");
+const structure = @import("structure.zig");
+const api_mod = @import("structure/api.zig");
+
+const so_path: []const u8 = bo.so_lib;
+const enabled = so_path.len > 0;
+const CAP: i32 = 512;
+
+/// Twenty tokens: JSON punctuation, a plain word, digits, whitespace, and fillers.
+const vocab = [_][]const u8{
+    "{", "}", ":", ",", "\"", "a", "b", "0", "1", " ",
+    "x", "y", "z", "q", "w", "e", "r", "t", "u", "i",
+};
+const padded = 32;
+
+const Fixture = struct {
+    api: api_mod.Api,
+    ctx: ?*anyopaque,
+
+    fn open() !Fixture {
+        var api = try api_mod.Api.load(so_path);
+        errdefer api.close();
+        var ptrs: [vocab.len]?[*]const u8 = undefined;
+        var lens: [vocab.len]i32 = undefined;
+        for (vocab, 0..) |v, i| {
+            ptrs[i] = v.ptr;
+            lens[i] = @intCast(v.len);
+        }
+        var err: [CAP]u8 = undefined;
+        const ctx = api.init(&ptrs, &lens, @intCast(vocab.len), padded, null, 0, &err, CAP) orelse
+            return error.InitFailed;
+        return .{ .api = api, .ctx = ctx };
+    }
+
+    fn close(self: *Fixture) void {
+        self.api.ctx_free(self.ctx);
+        self.api.close();
+    }
+};
+
+fn bitSet(words: []const i32, id: usize) bool {
+    const w = id / 32;
+    const b: u5 = @intCast(id % 32);
+    if (w >= words.len) return false;
+    return (words[w] >> b) & 1 == 1;
+}
+
+test "shim tests are skipped without -Dxgrammar" {
+    if (comptime !enabled) return error.SkipZigTest;
+    try std.testing.expect(comptime enabled);
+}
+
+test "init, compile a schema, and the first mask" {
+    if (comptime !enabled) return error.SkipZigTest;
+    if (comptime enabled) {
+        var fx = try Fixture.open();
+        defer fx.close();
+        var err: [CAP]u8 = undefined;
+        const g = fx.api.compile_json(fx.ctx, "{\"type\":\"object\"}", 1, &err, CAP) orelse {
+            std.debug.print("compile failed: {s}\n", .{std.mem.sliceTo(&err, 0)});
+            return error.CompileFailed;
+        };
+        defer fx.api.grammar_free(g);
+        try std.testing.expect(fx.api.grammar_bytes(g) > 0);
+
+        const m = fx.api.matcher_create(fx.ctx, g, &err, CAP) orelse return error.MatcherFailed;
+        defer fx.api.matcher_free(m);
+        var words: [1]i32 = .{0};
+        try std.testing.expect(fx.api.fill(m, &words) == 1);
+        try std.testing.expect(bitSet(&words, 0)); // "{"
+        try std.testing.expect(!bitSet(&words, 5)); // "a": not at the start of compact JSON
+        try std.testing.expect(fx.api.accept(m, 0) == 1); // "{"
+        try std.testing.expect(fx.api.accept(m, 1) == 1); // "}" closes the empty object
+        try std.testing.expect(fx.api.terminated(m) == 0); // the stop token has not been accepted
+    }
+}
+
+test "a compile failure carries the compiler's message, per call" {
+    if (comptime !enabled) return error.SkipZigTest;
+    if (comptime enabled) {
+        var fx = try Fixture.open();
+        defer fx.close();
+        var e1: [CAP]u8 = undefined;
+        var e2: [CAP]u8 = undefined;
+        try std.testing.expect(fx.api.compile_json(fx.ctx, "{\"type\":42}", 1, &e1, CAP) == null);
+        try std.testing.expect(fx.api.compile_json(fx.ctx, "not a schema at all", 1, &e2, CAP) == null);
+        const m1 = std.mem.sliceTo(&e1, 0);
+        const m2 = std.mem.sliceTo(&e2, 0);
+        try std.testing.expect(m1.len > 0 and m2.len > 0);
+        try std.testing.expect(!std.mem.eql(u8, m1, m2));
+    }
+}
+
+test "regex and EBNF grammars compile" {
+    if (comptime !enabled) return error.SkipZigTest;
+    if (comptime enabled) {
+        var fx = try Fixture.open();
+        defer fx.close();
+        var err: [CAP]u8 = undefined;
+        const re = fx.api.compile_regex(fx.ctx, "[A-Z]{2}-[0-9]{3}", &err, CAP) orelse return error.RegexFailed;
+        fx.api.grammar_free(re);
+        const eb = fx.api.compile_grammar(fx.ctx, "root ::= \"answer=\" [0-9]+", &err, CAP) orelse return error.EbnfFailed;
+        fx.api.grammar_free(eb);
+    }
+}
+
+test "choice becomes an EBNF alternation of quoted literals" {
+    const a = std.testing.allocator;
+    var msg: [CAP]u8 = undefined;
+    const g = try structure.choiceGrammar(a, "[\"a\",\"b\\\"c\"]", &msg);
+    defer a.free(g);
+    try std.testing.expectEqualStrings("root ::= \"\\\"a\\\"\" | \"\\\"b\\\"c\\\"\"", g);
+}
+
+test "the cache returns one grammar per (kind, text) and dedupes concurrent compiles" {
+    if (comptime !enabled) return error.SkipZigTest;
+    if (comptime enabled) {
+        var fx = try Fixture.open();
+        defer fx.close();
+        var cache = structure.Cache.init(std.testing.allocator, std.testing.io, &fx.api, fx.ctx, 4 << 20);
+        defer cache.deinit();
+        var err: [CAP]u8 = undefined;
+
+        const a1 = try cache.getOrCompile(.json_schema, "{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}}}", &err, 5000);
+        const a2 = try cache.getOrCompile(.json_schema, "{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}}}", &err, 5000);
+        try std.testing.expectEqual(a1, a2); // same text: one grammar
+        const b1 = try cache.getOrCompile(.json_schema, "{\"type\":\"object\",\"properties\":{\"b\":{\"type\":\"string\"}}}", &err, 5000);
+        try std.testing.expect(a1 != b1); // different text, same shape: a different grammar
+        try std.testing.expect(cache.currentBytes() > 0);
+    }
+}
+
+test "an invalid schema through the cache reports the compiler's message" {
+    if (comptime !enabled) return error.SkipZigTest;
+    if (comptime enabled) {
+        var fx = try Fixture.open();
+        defer fx.close();
+        var cache = structure.Cache.init(std.testing.allocator, std.testing.io, &fx.api, fx.ctx, 1 << 20);
+        defer cache.deinit();
+        var err: [CAP]u8 = std.mem.zeroes([CAP]u8);
+        try std.testing.expectError(error.CompileFailed, cache.getOrCompile(.json_schema, "{\"type\":42}", &err, 5000));
+        try std.testing.expect(std.mem.sliceTo(&err, 0).len > 0);
+    }
+}
+
+test "the byte bound evicts the least recently used grammar" {
+    if (comptime !enabled) return error.SkipZigTest;
+    if (comptime enabled) {
+        var fx = try Fixture.open();
+        defer fx.close();
+        var cache = structure.Cache.init(std.testing.allocator, std.testing.io, &fx.api, fx.ctx, 1);
+        defer cache.deinit();
+        var err: [CAP]u8 = undefined;
+        _ = try cache.getOrCompile(.json_schema, "{\"type\":\"object\"}", &err, 5000);
+        _ = try cache.getOrCompile(.json_schema, "{\"type\":\"object\",\"properties\":{\"z\":{\"type\":\"number\"}}}", &err, 5000);
+        try std.testing.expect(cache.currentBytes() <= 1);
+    }
+}
