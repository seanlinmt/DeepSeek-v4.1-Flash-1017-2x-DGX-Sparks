diff --git a/zig/src/server/structure.zig b/zig/src/server/structure.zig
new file mode 100644
index 0000000000000000000000000000000000000000..32c1842adf08a24be9ded4e236b0e32b4f66f480
--- /dev/null
+++ b/zig/src/server/structure.zig
@@ -0,0 +1,188 @@
+//! Boot-time wiring of the structured-output grammar engine: the vocabulary (from the server's
+//! Text), the shim library, and the compile cache. `TF_DS_SO=0`, a missing library or a missing
+//! build option leaves the server without structured output (Info.structures stays false), never
+//! a crash.
+const std = @import("std");
+const engine_api = @import("engine_api");
+const structure = @import("structure");
+const model_text = @import("model_text.zig");
+const bo = @import("build_options");
+const log = @import("log.zig");
+
+/// The grammar kinds, re-exported so the server names one type for both modules.
+pub const Kind = structure.Kind;
+
+pub const Padded = struct { vocab: u32 };
+
+/// One initialized grammar engine: the shim (heap-owned: the cache holds a pointer to it), the
+/// tokenizer context it was built from, and the compile cache.
+pub const So = struct {
+    a: std.mem.Allocator,
+    api: *structure.Api,
+    ctx: ?*anyopaque,
+    cache: structure.Cache,
+    padded: u32,
+    /// Ids whose token is only whitespace: what the bounded leading-whitespace phase may emit.
+    ws_ids: []u32,
+    /// The matcher table a family drives: one matcher a stream, over the grammar the request compiled.
+    ops: engine_api.StructureOps,
+
+    pub fn deinit(self: *So, a: std.mem.Allocator) void {
+        a.free(self.ws_ids);
+        self.cache.deinit();
+        self.api.ctx_free(self.ctx);
+        self.api.close();
+        a.destroy(self.api);
+        a.destroy(self);
+    }
+
+    /// One stream's matcher: the shim's, behind the allocator's own record (the table's calls get only the
+    /// matcher, and the record keeps the shim and the allocator that frees it).
+    const Matcher = struct {
+        a: std.mem.Allocator,
+        api: *structure.Api,
+        m: *anyopaque,
+    };
+
+    fn opCreate(p: *anyopaque, grammar: ?*anyopaque) ?*anyopaque {
+        const self: *So = @ptrCast(@alignCast(p));
+        var err: [512]u8 = std.mem.zeroes([512]u8);
+        const raw = self.api.matcher_create(self.ctx, grammar, &err, @intCast(err.len)) orelse {
+            log.line("structured output: no matcher for this reply: {s}", .{std.mem.sliceTo(&err, 0)});
+            return null;
+        };
+        const mt = self.a.create(Matcher) catch {
+            self.api.matcher_free(raw);
+            return null;
+        };
+        mt.* = .{ .a = self.a, .api = self.api, .m = raw };
+        return mt;
+    }
+
+    fn opFill(p: *anyopaque, bits: []i32) i32 {
+        const mt: *Matcher = @ptrCast(@alignCast(p));
+        return mt.api.fill(mt.m, bits.ptr);
+    }
+
+    fn opAccept(p: *anyopaque, id: u32) bool {
+        const mt: *Matcher = @ptrCast(@alignCast(p));
+        return mt.api.accept(mt.m, @intCast(id)) == 1;
+    }
+
+    fn opTerminated(p: *anyopaque) bool {
+        const mt: *Matcher = @ptrCast(@alignCast(p));
+        return mt.api.terminated(mt.m) == 1;
+    }
+
+    fn opFree(p: *anyopaque) void {
+        const mt: *Matcher = @ptrCast(@alignCast(p));
+        mt.api.matcher_free(mt.m);
+        mt.a.destroy(mt);
+    }
+};
+
+/// The library path baked at build time (`-Dxgrammar`), or "" when the build has no shim.
+pub fn soPath() []const u8 {
+    // the image installs the library at a fixed path; a developer build points at its cache
+    if (bo.so_lib_runtime.len > 0) return bo.so_lib_runtime;
+    return bo.so_lib;
+}
+
+/// `TF_DS_SO` (default 1): 0 leaves the capability off.
+pub fn enabled() bool {
+    const v = getenv("TF_DS_SO") orelse return true;
+    return !(v.len == 1 and v[0] == '0');
+}
+
+/// `TF_DS_SO_CACHE_BYTES` (default 256 MiB): the compile cache's byte bound, 0 = compile per request.
+pub fn cacheBytes() usize {
+    const v = getenv("TF_DS_SO_CACHE_BYTES") orelse return 256 << 20;
+    return std.fmt.parseInt(usize, v, 10) catch 256 << 20;
+}
+
+/// `TF_DS_SO_TIMEOUT_S` (default 20): a compile past it is refused at admission.
+pub fn timeoutMs() u64 {
+    const v = getenv("TF_DS_SO_TIMEOUT_S") orelse return 20_000;
+    const s = std.fmt.parseInt(u64, v, 10) catch 20;
+    return s * 1000;
+}
+
+fn getenv(name: [:0]const u8) ?[]const u8 {
+    return std.mem.span(std.c.getenv(name) orelse return null);
+}
+
+/// Build the vocabulary from the server's Text: each id's exact decoded bytes (RAW), specials
+/// blocked with empty bytes so the mask can never produce them, the EOS ids as stops, and the
+/// model's padded width as the mask's vocabulary size.
+pub fn init(a: std.mem.Allocator, io: std.Io, text: model_text.Text, padded: u32) !*So {
+    if (soPath().len == 0) return error.NoShim;
+
+    const api = try a.create(structure.Api);
+    errdefer a.destroy(api);
+    api.* = try structure.Api.load(soPath());
+    errdefer api.close();
+
+    const n = text.vocabSize();
+    const bytes = try a.alloc(?[*]const u8, n);
+    defer a.free(bytes);
+    const lens = try a.alloc(i32, n);
+    defer a.free(lens);
+    var owned: std.ArrayListUnmanaged([]u8) = .empty;
+    defer {
+        for (owned.items) |b| a.free(b);
+        owned.deinit(a);
+    }
+    var ws: std.ArrayListUnmanaged(u32) = .empty;
+    errdefer ws.deinit(a);
+
+    for (0..n) |i| {
+        const id: u32 = @intCast(i);
+        const is_special = if (text.vtable.special) |sp| sp(text.ctx, id) else false;
+        if (is_special) {
+            bytes[i] = null;
+            lens[i] = 0;
+            continue;
+        }
+        const b = text.decode(a, &.{id}) catch {
+            bytes[i] = null;
+            lens[i] = 0;
+            continue;
+        };
+        try owned.append(a, b);
+        bytes[i] = b.ptr;
+        lens[i] = @intCast(b.len);
+        if (allWhitespace(b)) try ws.append(a, id);
+    }
+
+    const eos = text.eosIds();
+    const stops = try a.alloc(i32, eos.len);
+    defer a.free(stops);
+    for (eos, 0..) |v, i| stops[i] = @intCast(v);
+    var err: [512]u8 = std.mem.zeroes([512]u8);
+    const ctx = api.init(@ptrCast(bytes.ptr), lens.ptr, @intCast(n), @intCast(padded), if (stops.len > 0) stops.ptr else null, @intCast(stops.len), &err, @intCast(err.len)) orelse {
+        log.line("structured output: the shim rejected the vocabulary: {s}", .{std.mem.sliceTo(&err, 0)});
+        return error.VocabRefused;
+    };
+
+    const so = try a.create(So);
+    errdefer a.destroy(so);
+    const ws_ids = try ws.toOwnedSlice(a);
+    errdefer a.free(ws_ids);
+    so.* = .{
+        .a = a,
+        .api = api,
+        .ctx = ctx,
+        .cache = structure.Cache.init(a, io, api, ctx, cacheBytes()),
+        .padded = padded,
+        .ws_ids = ws_ids,
+        .ops = .{ .ctx = so, .create = So.opCreate, .fill = So.opFill, .accept = So.opAccept, .terminated = So.opTerminated, .free = So.opFree },
+    };
+    return so;
+}
+
+/// A token's bytes are whitespace only (and not empty): what the leading-whitespace phase may emit.
+fn allWhitespace(b: []const u8) bool {
+    if (b.len == 0) return false;
+    for (b) |c| if (c != ' ' and c != '\n' and c != '\r' and c != '\t') return false;
+    return true;
+}
