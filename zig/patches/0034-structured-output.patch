+            "echo tfso-so-ok",
+        .{ xgrammar, xgrammar },
+    );
+    const run = b.addSystemCommand(&.{ "sh", "-c", script, "tfso" });
+    run.addFileArg(b.path("zig/src/core/structure/tfso.cc"));
+    return run.addOutputFileArg("libtfso.so");
+}
