diff --git a/zig/src/families/dsv41/structure_mask.zig b/zig/src/families/dsv41/structure_mask.zig
new file mode 100644
index 0000000000000000000000000000000000000000..976e4f87527f07f7486224647c58e5c8537520e0
--- /dev/null
+++ b/zig/src/families/dsv41/structure_mask.zig
@@ -0,0 +1,60 @@
+//! The grammar mask's arithmetic, and the row application the decode loop calls before `sampleDev`.
+//!
+//! The served sampler reads only a row's top_k + margin candidates from the device, so a mask has
+//! to be in the logits before that read. v1 applies it on the host: copy the row down, set `-inf`
+//! where the bit is 0, copy it back — constrained rows only, one row a round, against a 30-60 ms
+//! round. Ids past the mask's words are `-inf` too, so a vocabulary padded past the tokenizer's
+//! size cannot leak an unmasked token. A device kernel is the v2 fast path.
+const std = @import("std");
+
+/// `-inf` where the bit is 0, over `vocab` entries; ids past `bits` are masked as well. Pure:
+/// the unit test below drives it, and the device path calls it on the copied row.
+pub fn maskRow(row: []f32, bits: []const i32, vocab: usize) void {
+    const n = @min(row.len, vocab);
+    for (0..n) |i| {
+        const w = i / 32;
+        const b: u5 = @intCast(i % 32);
+        const allowed = w < bits.len and ((bits[w] >> b) & 1) == 1;
+        if (!allowed) row[i] = -std.math.inf(f32);
+    }
+    var i = n;
+    while (i < row.len) : (i += 1) row[i] = -std.math.inf(f32);
+}
+
+/// The mask a row of an all-ones grammar needs: every id allowed (the idle state before the
+/// grammar engages, and after it completes).
+pub fn fillAll(bits: []i32, vocab: usize) void {
+    for (bits) |*w| w.* = -1;
+    const rem = vocab % 32;
+    if (rem != 0 and bits.len > 0) {
+        const keep: u5 = @intCast(rem);
+        bits[bits.len - 1] = (@as(i32, 1) << keep) - 1;
+    }
+}
+
+test "maskRow masks disallowed entries and everything past the vocabulary" {
+    var row: [40]f32 = undefined;
+    for (&row) |*v| v.* = 1.0;
+    var bits: [1]i32 = .{0};
+    bits[0] = (1 << 0) | (1 << 5) | (1 << 9); // ids 0, 5, 9 allowed
+    maskRow(&row, &bits, 32);
+    try std.testing.expect(row[0] == 1.0);
+    try std.testing.expect(row[5] == 1.0);
+    try std.testing.expect(row[9] == 1.0);
+    try std.testing.expect(row[1] == -std.math.inf(f32));
+    try std.testing.expect(row[31] == -std.math.inf(f32));
+    // ids past the vocabulary are masked too, even though their bits were never written
+    try std.testing.expect(row[32] == -std.math.inf(f32));
+    try std.testing.expect(row[39] == -std.math.inf(f32));
+}
+
+test "fillAll allows every id of the vocabulary, including a partial last word" {
+    var bits: [2]i32 = .{ 0, 0 };
+    fillAll(&bits, 40); // 32 + 8
+    try std.testing.expect(bits[0] == -1);
+    try std.testing.expect(bits[1] == (1 << 8) - 1);
+    var row: [40]f32 = undefined;
+    for (&row) |*v| v.* = 2.0;
+    maskRow(&row, &bits, 40);
+    for (row) |v| try std.testing.expect(v == 2.0);
+}
