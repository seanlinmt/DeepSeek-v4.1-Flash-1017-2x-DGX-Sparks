+    // short-request lanes (ShortLaneConfig, TF_DS_SHORT_* / TF_SHORT_* / TF_ACTIVE_KV_CAP / TF_BYPASS_MAX_SKIPS /
+    // TF_KV_ALLOC_STEP): lanes kept for short requests, an aggregate KV cap on long admissions, and short requests let
+    // past a front request that waits for room (full_wait) or is held from active_kv_cap by admitted short streams,
+    // bypass_max_skips of them at most per wait
+    short: ShortLaneConfig = .{},
+    bypass_skips: u32 = 0,
+    cap_wait_id: ?Id = null, // front job held from active_kv_cap by admitted short streams (bounded by bypass_max_skips)
+    cap_skips: u32 = 0,
     // -- parked requests (0110). The lists are the engine thread's; changes take the lock (status reads their lengths).
     ready: std.ArrayList(*Job) = .empty, // woken: admitted before the queue, in the order they woke
     loading: std.ArrayList(Load) = .empty, // each waits for a restore job (several may share one)
@@ -211,6 +219,38 @@ pub const LaneHost = struct {
         restores_room_wait_expired: u64 = 0, // of them, admitted on memory at load_wait_ns
     };
 
+    /// Short-request lanes and the long admissions' KV cap (LaneHost.init reads them from the environment; 0 turns a
+    /// bound off). A request is short when its uncached prompt tokens fit cut_in (when set), its whole prompt fits
+    /// total_ctx_max, and uncached prompt tokens + its short-lane decode bound (min(max_tokens, demote_tokens), or
+    /// max_tokens when demotion is off) fit max_tokens.
+    pub const ShortLaneConfig = struct {
+        reserve: u32 = 1, // TF_DS_SHORT_RESERVE_LANES: lanes long requests may not take (clamped to lanes - 1)
+        max_tokens: u32 = 6144, // TF_DS_SHORT_MAX_TOKENS: uncached prompt tokens + short-lane decode bound
+        total_ctx_max: u32 = 32768, // TF_SHORT_TOTAL_CTX_MAX: cached + uncached prompt tokens
+        demote_tokens: u32 = 512, // TF_SHORT_DEMOTE_TOKENS: a short stream decoding this many tokens counts as long
+        active_kv_cap: u32 = 786432, // TF_ACTIVE_KV_CAP: admitted streams' estimated KV tokens, for long admissions
+        bypass_max_skips: u32 = 4, // TF_BYPASS_MAX_SKIPS: short admissions past a front waiting for room or held from active_kv_cap by short streams
+        kv_alloc_step: u32 = 512, // TF_KV_ALLOC_STEP: decode tokens a stream's KV estimate runs ahead of its context
+
+        pub fn fromEnv() ShortLaneConfig {
+            const d: ShortLaneConfig = .{};
+            return .{
+                .reserve = envU32("TF_DS_SHORT_RESERVE_LANES", d.reserve),
+                .max_tokens = envU32("TF_DS_SHORT_MAX_TOKENS", d.max_tokens),
+                .total_ctx_max = envU32("TF_SHORT_TOTAL_CTX_MAX", d.total_ctx_max),
+                .demote_tokens = envU32("TF_SHORT_DEMOTE_TOKENS", d.demote_tokens),
+                .active_kv_cap = envU32("TF_ACTIVE_KV_CAP", d.active_kv_cap),
+                .bypass_max_skips = envU32("TF_BYPASS_MAX_SKIPS", d.bypass_max_skips),
+                .kv_alloc_step = envU32("TF_KV_ALLOC_STEP", d.kv_alloc_step),
+            };
+        }
+
+        fn envU32(name: [*:0]const u8, default: u32) u32 {
+            const v = std.c.getenv(name) orelse return default;
+            return std.fmt.parseInt(u32, std.mem.span(v), 10) catch default;
+        }
+    };
+
     const Job = struct {
         host: *LaneHost,
         id: Id,
@@ -234,6 +274,8 @@ pub const LaneHost = struct {
         fork: u32 = 0,
         lineage: []pc.Fork = &.{}, // the computation its pass's rows belong to (gpa-owned; Store.passLineage)
         whole: bool = false, // refused as a cut-in (error.FillBusy: its kept state gone): it waits for the pass in pieces
+        is_short: bool = false, // qualified as short when last admitted (qualifiesAsShort); demoted by isLongNow
+        pool_blocked: bool = false, // refused for room (ContextFull): skipped by the scan until full_wait clears
 
         /// The backend's prompt pass stands at a mark: the cache keeps the stream's state there.
         fn kept(ptr: *anyopaque, s: *lanes.Stream, at: u32) void {
@@ -285,6 +327,137 @@ pub const LaneHost = struct {
         return @min(@as(usize, e.at), r.prompt.len);
     }
 
+    /// Whether a request is short (ShortLaneConfig): its uncached prompt tokens fit cut_in (when set), its whole prompt
+    /// fits total_ctx_max, and uncached prompt tokens + its short-lane decode bound (demote_tokens when set, else
+    /// max_tokens) fit max_tokens. Not tied to reserve > 0: a short request may pass a front request that waits for room
+    /// with no lane reserved.
+    fn qualifiesAsShort(h: *LaneHost, r: *const Request) bool {
+        const uncached = r.prompt.len -| h.resumable(r);
+        if (h.core.cut_in > 0 and uncached > h.core.cut_in) return false;
+        if (h.short.total_ctx_max > 0 and r.prompt.len > h.short.total_ctx_max) return false;
+        if (h.short.max_tokens > 0) {
+            const out = if (h.short.demote_tokens > 0) @min(r.max_tokens, h.short.demote_tokens) else r.max_tokens;
+            if (uncached +| @as(usize, out) > h.short.max_tokens) return false;
+        }
+        return true;
+    }
+
+    /// An admitted job counts as long: it did not qualify as short, or it has decoded demote_tokens since (the lock held).
+    fn isLongNow(h: *const LaneHost, job: *const Job) bool {
+        if (!job.is_short) return true;
+        const d = h.short.demote_tokens;
+        return d > 0 and job.started and job.stream.emitted().len >= d;
+    }
+
+    fn longAdmittedCount(h: *const LaneHost) usize {
+        var count: usize = 0;
+        for (h.admitted.items) |job| if (h.isLongNow(job)) {
+            count += 1;
+        };
+        return count;
+    }
+
+    /// A stream's KV estimate: its context, and kv_alloc_step tokens of the decode left (all of it when the step is 0).
+    fn kvEstimate(h: *const LaneHost, prompt: usize, context: usize, left: usize) usize {
+        const ahead = if (h.short.kv_alloc_step > 0) @min(left, h.short.kv_alloc_step) else left;
+        return @max(prompt, context) +| ahead;
+    }
+
+    /// An admitted job's current KV estimate (the lock held).
+    fn jobKvEstimate(h: *const LaneHost, job: *const Job) usize {
+        const r = job.request;
+        return if (job.started)
+            h.kvEstimate(r.prompt.len, job.stream.context.items.len, @intCast(@max(job.stream.budgetLeft(), 0)))
+        else
+            h.kvEstimate(r.prompt.len, 0, r.max_tokens);
+    }
+
+    /// The admitted streams' KV estimates together (the lock held).
+    fn activeKvTokens(h: *const LaneHost) usize {
+        var total: usize = 0;
+        for (h.admitted.items) |job| total +|= h.jobKvEstimate(job);
+        return total;
+    }
+
+    /// Whether `job` may take a free lane: a long one keeps `reserve` lanes for short requests and, with other streams
+    /// admitted, keeps their KV estimates and its own within active_kv_cap (the lock held).
+    fn canAdmitJob(h: *const LaneHost, job: *const Job, short: bool) bool {
+        if (h.admitted.items.len >= h.info_.lanes) return false;
+        if (short) return true;
+        if (h.longAdmittedCount() >= h.info_.lanes -| h.short.reserve) return false;
+        const cap = h.short.active_kv_cap;
+        if (cap > 0 and h.admitted.items.len > 0) {
+            const r = job.request;
+            if (h.activeKvTokens() +| h.kvEstimate(r.prompt.len, 0, r.max_tokens) > cap) return false;
+        }
+        return true;
+    }
+
+    /// Whether `j` may be selected from `ready` or `queued` now (the lock held); sets `j.is_short` when true.
+    fn canSelect(h: *LaneHost, j: *Job, bypass_only: bool) bool {
+        if (j.pool_blocked) return false;
+        const r = j.request;
+        if (h.filling != null) {
+            if (j.whole) return false;
+            const from = h.resumable(r);
+            if (!h.core.cutsIn(r.prompt.len - from, lanes.Engine.picturesPast(r.images, from))) return false;
+        }
+        const short = h.qualifiesAsShort(r);
+        if (bypass_only and !short) return false;
+        if (!h.canAdmitJob(j, short)) return false;
+        j.is_short = short;
+        return true;
+    }
+
+    /// The front request no longer waits for room: every request refused for room may be tried again (the lock held).
+    fn clearFullWait(h: *LaneHost) void {
+        h.full_wait = null;
+        h.bypass_skips = 0;
+        for (h.queued.items) |j| j.pool_blocked = false;
+    }
+
+    /// Whether `job` (a long front request) is held by active_kv_cap specifically because of admitted short streams:
+    /// either its own KV estimate exceeds active_kv_cap and only short streams remain admitted (so it needs admitted == 0),
+    /// or it would fit under active_kv_cap alongside the admitted long streams alone (the lock held).
+    fn capBlockedByShort(h: *LaneHost, job: *const Job) bool {
+        const cap = h.short.active_kv_cap;
+        if (cap == 0 or h.admitted.items.len == 0) return false;
+        if (job.pool_blocked) return false;
+        const r = job.request;
+        if (h.qualifiesAsShort(r)) return false;
+        if (h.longAdmittedCount() >= h.info_.lanes -| h.short.reserve) return false;
+        const need = h.kvEstimate(r.prompt.len, 0, r.max_tokens);
+        var long_count: usize = 0;
+        var long_kv: usize = 0;
+        var short_kv: usize = 0;
+        for (h.admitted.items) |a| {
+            const est = h.jobKvEstimate(a);
+            if (h.isLongNow(a)) {
+                long_count += 1;
+                long_kv +|= est;
+            } else {
+                short_kv +|= est;
+            }
+        }
+        if ((long_kv +| short_kv) +| need <= cap) return false;
+        return (need > cap and long_count == 0) or (long_kv +| need <= cap);
+    }
+
+    fn clearCapWait(h: *LaneHost) void {
+        h.cap_wait_id = null;
+        h.cap_skips = 0;
+    }
+
+    /// Where a request refused for room goes back in the queue (the lock held): the front, or, while the front already
+    /// waits for room, behind the requests waiting for it, so a short request refused as it passed them does not take
+    /// the front's place. True when the front already waits (full_wait and full_retry stay as they are).
+    fn requeueAt(h: *const LaneHost) struct { usize, bool } {
+        if (h.full_wait == null) return .{ 0, false };
+        var at: usize = 0;
+        while (at < h.queued.items.len and h.queued.items[at].pool_blocked) at += 1;
+        return .{ at, true };
+    }
+
     /// The pictures' identities the durable tier gets for a request: its `cache_media` only when they name exactly the
     /// spans the engine runs (`images`: the spans its restored rows and tower work are placed by), one for one; anything
     /// else gives none, and the tier then misses and keeps nothing for it (a disk hit must not resume pictures placed
@@ -300,7 +473,9 @@ pub const LaneHost = struct {
         enforced.loop_guard = true;
         var ms: i96 = 0;
         if (std.c.getenv("TF_DS_PREFILL_INTERLEAVE_MS")) |v| ms = std.fmt.parseInt(u32, std.mem.span(v), 10) catch 0;
-        return .{ .gpa = gpa, .io = io, .core = core, .info_ = enforced, .interleave_ns = ms * std.time.ns_per_ms };
+        var short = ShortLaneConfig.fromEnv();
+        short.reserve = @min(short.reserve, enforced.lanes -| 1); // a long request always has a lane
+        return .{ .gpa = gpa, .io = io, .core = core, .info_ = enforced, .interleave_ns = ms * std.time.ns_per_ms, .short = short };
     }
 
     /// The tier's switches (before start). Telemetry is published from here on when either is on: a tier on the cache
@@ -524,11 +699,13 @@ pub const LaneHost = struct {
             for (h.queued.items, 0..) |job, i| if (job.id == id) {
                 // the queue's front waits for room (requeue, waitRoom: full_wait holds every admission meanwhile);
                 // cancelled, nothing waits for it any more
-                if (i == 0) h.full_wait = null;
+                if (i == 0) h.clearFullWait();
+                if (h.cap_wait_id == job.id) h.clearCapWait();
                 dropped.append(h.gpa, h.queued.orderedRemove(i)) catch {};
                 break;
             };
             for (h.ready.items, 0..) |job, i| if (job.id == id) {
+                if (h.cap_wait_id == job.id) h.clearCapWait();
                 dropped.append(h.gpa, h.ready.orderedRemove(i)) catch {};
                 break;
             };
@@ -578,7 +755,9 @@ pub const LaneHost = struct {
         h.mutex.unlock(h.io);
     }
 
-    /// Prefills the next queued request (while a pass fills, the first that core.cutsIn); false if none or no lane.
+    /// Prefills the next request the lanes admit (canAdmitJob; while a pass fills, the first that core.cutsIn; while the
+    /// front waits for room or is held from active_kv_cap by admitted short streams, a short one, bypass_max_skips at
+    /// most); false if none or no lane.
     fn admitOne(h: *LaneHost) bool {
         if (h.isBroken()) return false;
         h.lock();
@@ -586,38 +765,86 @@ pub const LaneHost = struct {
             h.unlock();
             return false;
         }
-        var at: usize = 0;
-        if (h.filling != null) {
-            at = for (h.queued.items, 0..) |j, i| {
-                if (j.whole) continue;
