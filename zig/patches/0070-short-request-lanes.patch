+        var retry_skips: u32 = 0;
         if (h.full_wait) |n| {
             const active = h.core.activeCount();
-            if (active > 0 and active >= n and std.Io.Clock.awake.now(h.io).toNanoseconds() < h.full_retry) {
-                h.unlock();
-                return false;
+            if (active == 0 or active < n) {
+                h.clearFullWait();
+            } else if (std.Io.Clock.awake.now(h.io).toNanoseconds() >= h.full_retry) {
+                retry_skips = h.bypass_skips;
+                h.clearFullWait();
             }
-            h.full_wait = null;
         }
-        if (h.finish_until) |t| {
-            if (std.Io.Clock.awake.now(h.io).toNanoseconds() < t and h.nearEnd()) {
+        const waiting = h.full_wait != null; // the front waits for room: only short requests pass it, a few at most
+        if (waiting and h.bypass_skips >= h.short.bypass_max_skips) {
+            h.unlock();
+            return false;
+        }
+        // When a front request is held from active_kv_cap because of admitted short streams, bound short bypasses past it
+        // by bypass_max_skips too so >active_kv_cap or short-KV-blocked long requests drain instead of starving.
+        const cap_front: ?*Job = if (!waiting and retry_skips == 0 and h.filling == null)
+            (if (h.ready.items.len > 0) h.ready.items[0] else if (h.queued.items.len > 0) h.queued.items[0] else null)
+        else
+            null;
+        const cap_wait = if (cap_front) |front| blk: {
+            if (!h.capBlockedByShort(front)) {
+                if (h.cap_wait_id == front.id) h.clearCapWait();
+                break :blk false;
+            }
+            if (h.cap_wait_id != front.id) {
+                h.cap_wait_id = front.id;
+                h.cap_skips = 0;
+            }
+            break :blk true;
+        } else false;
+        // a woken (restored) request goes first when the lanes admit it (and it cuts in while a pass fills), but not
+        // while the front waits for room; if none in `ready` is eligible, fall through to `queued`
+        const woken: ?*Job = if (!waiting and retry_skips == 0) blk: {
+            for (h.ready.items, 0..) |j, i| {
+                const skipping_front = cap_wait and cap_front != null and j != cap_front.?;
+                if (skipping_front and h.cap_skips >= h.short.bypass_max_skips) break;
+                if (!h.canSelect(j, skipping_front)) continue;
+                if (skipping_front) h.cap_skips += 1;
+                break :blk h.ready.orderedRemove(i);
+            }
+            break :blk null;
+        } else null;
+        var front_retry = false;
+        const job = woken orelse blk: {
+            const found: ?usize = for (h.queued.items, 0..) |j, i| {
+                const skipping_front = cap_wait and cap_front != null and j != cap_front.?;
+                if (skipping_front and h.cap_skips >= h.short.bypass_max_skips) break null;
+                const bypass_only = waiting or skipping_front or (i > 0 and h.filling == null);
+                if (!h.canSelect(j, bypass_only)) continue;
+                if (waiting) h.bypass_skips += 1; // (counted as tried: a bypass refused for room counts too)
+                if (skipping_front) h.cap_skips += 1;
+                break i;
+            } else null;
+            const at = found orelse {
                 h.unlock();
                 return false;
-            }
-            h.finish_until = null;
-        }
-        // a woken (restored) request goes first, but not while a pass fills: then only a queued one that cuts in
-        const job = if (h.filling == null and h.ready.items.len > 0) h.ready.orderedRemove(0) else h.queued.orderedRemove(at);
+            };
+            front_retry = (at == 0 and retry_skips > 0);
+            break :blk h.queued.orderedRemove(at);
+        };
+        if (h.cap_wait_id == job.id) h.clearCapWait();
         if (h.parking()) {
             h.unlock();
-            if (h.park(job)) return true; // waits for a restore, holding no lane
+            if (h.park(job)) {
+                if (front_retry) {
+                    h.lock();
+                    if (h.full_wait != null) h.bypass_skips = retry_skips;
+                    h.unlock();
+                }
+                return true; // waits for a restore, holding no lane
+            }
             h.lock();
         }
         h.admitted.append(h.gpa, job) catch {
@@ -696,8 +923,18 @@ pub const LaneHost = struct {
         added catch |e| {
             if (h.isBroken()) return h.dropBroken(job);
             if (e == error.Cancelled) return h.cancel(job);
-            // refused for room: while other streams run or a pass fills (this one cut in), it waits in the queue
-            if (e == error.ContextFull and (h.core.activeCount() > 0 or h.filling != null)) return h.requeue(job);
+            // refused for room: while other streams run or a pass fills (this one cut in), it waits in the queue; while
+            // streams run, a short request behind it may be tried at once (true: admitOne runs again and finds one or none)
+            if (e == error.ContextFull and (h.core.activeCount() > 0 or h.filling != null)) {
